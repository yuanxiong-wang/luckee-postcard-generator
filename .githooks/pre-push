#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"

echo "Building the Cloudflare root bundle before push..."
npx pnpm@10.4.1 build

if ! git diff --quiet -- \
  index.html \
  assets \
  _headers \
  _redirects \
  favicon.svg \
  og-image.svg \
  robots.txt \
  sitemap.xml \
  llms.txt \
  holiday-backgrounds \
  client/public/holiday-backgrounds
then
  echo "Static root bundle is out of date."
  echo "Commit the files produced by pnpm build, then push again."
  git diff --stat -- \
    index.html \
    assets \
    _headers \
    _redirects \
    favicon.svg \
    og-image.svg \
    robots.txt \
    sitemap.xml \
    llms.txt \
    holiday-backgrounds \
    client/public/holiday-backgrounds
  exit 1
fi
